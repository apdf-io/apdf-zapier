# Point the integration at a local or staging Apdf instead of https://apdf.io/api.
APDF_BASE_URL=http://apdf.localhost/api

# API tokens the integration tests run with: one of a workspace on a plan with automations
# (Pro or Business), and one of a Hobby workspace for the plan refusals.
APDF_TEST_TOKEN=
APDF_TEST_HOBBY_TOKEN=

# The connection `zapier-platform invoke` uses when you try a step locally.
authData_api_token=
