{
  "name": "apdf-zapier",
  "version": "0.1.0",
  "description": "Zapier integration for Apdf — PDF tracking links, reader analytics and PDF processing",
  "scripts": {
    "test": "npm run build && vitest --run",
    "clean": "rimraf ./dist ./build",
    "build": "npm run clean && tsc",
    "dev": "npm run build -- --watch",
    "_zapier-build": "npm run build",
    "format": "prettier --write .",
    "lint": "prettier --check . && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "zapier-platform-core": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "prettier": "3.9.9",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "zapier-platform-cli": "19.2.0"
  },
  "private": true,
  "exports": "./dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://apdf.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apdf-io/apdf-zapier.git"
  },
  "bugs": {
    "url": "https://github.com/apdf-io/apdf-zapier/issues"
  }
}
